# --- Required ---

# Neon Postgres connection string (use the "pooled" one), free tier
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random text used to sign admin logins. Make one with: openssl rand -base64 48
AUTH_SECRET=

# Public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://daffodils.com

# Admin subdomain. The admin panel only opens on this host; on the main site /admin returns 404.
# Leave empty for local development (then use http://localhost:3000/admin).
ADMIN_HOST=admin.daffodils.com

# --- Photos (Cloudinary free plan) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For local testing without Cloudinary: saves photos in ./.data/uploads (do not use on Netlify/Vercel)
# STORAGE=local
